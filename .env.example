# Template only. Inject values through the service manager or use backend.serve --env-file.
# Never place this token in frontend code. Generate a random secret; blank is rejected.
UPSCALER_PRODUCTION=1
UPSCALER_API_TOKEN=
UPSCALER_ALLOWED_HOSTS=127.0.0.1,localhost
UPSCALER_ALLOWED_ORIGINS=
UPSCALER_ENABLE_GENERATION=0
UPSCALER_PORT=8000
UPSCALER_MAX_JOBS=4
UPSCALER_SUBMISSIONS_PER_MINUTE=30
UPSCALER_TIMEOUT=21600
UPSCALER_TTL=86400
UPSCALER_THREADS=4
# Leave paths unset to keep runtime files beneath the project on D:.
# UPSCALER_DATA_DIR=D:/upscaler-runtime/data
# UPSCALER_MODELS_DIR=D:/upscaler-runtime/models
# UPSCALER_CACHE_DIR=D:/upscaler-runtime/cache
